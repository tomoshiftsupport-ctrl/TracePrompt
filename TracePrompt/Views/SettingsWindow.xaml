<Window x:Class="TracePrompt.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="記録の設定"
        Height="640"
        Width="560"
        MinHeight="420"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Bg}"
        FontFamily="Yu Gothic UI, Segoe UI">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top"
                   Text="記録の設定"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource Brush.TextPrimary}"
                   Margin="0,0,0,14"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- 操作ボタン（開始／停止は本体のステータスバーへ集約）。
                     削除は取り返しがつかない操作なので、隣の「フォルダを開く」から離し、
                     区切り線を挟んで誤クリックしにくいようにしています。 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="スクショ保存フォルダを開く"
                            Style="{StaticResource LinkButtonStyle}"
                            Padding="14,0"
                            Command="{Binding OpenTempFolderCommand}"/>
                    <Border Width="1" Background="{StaticResource Brush.Border}" Margin="18,4,18,4"/>
                    <Button Content="記録データを今すぐ削除"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="16,0"
                            Command="{Binding ClearHistoryCommand}"/>
                </StackPanel>

                <!-- キャプチャモード -->
                <Border Style="{StaticResource InnerBoxStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4" LastChildFill="False">
                            <TextBlock Text="キャプチャモード" Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Style="{StaticResource HelpBadgeStyle}">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="キャプチャモード" Style="{StaticResource ToolTipTitleStyle}"/>
                                            <TextBlock TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"
                                                       Text="・時間でキャプチャ … 設定した枚/秒で連続撮影し、操作は最寄りの画像に紐づけます。"/>
                                            <TextBlock TextWrapping="Wrap" LineHeight="18"
                                                       Text="・操作でキャプチャ … 指定したキー／マウス操作のときだけスクリーンショットを撮ります。連続の定期撮影はしません。"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Style="{StaticResource HelpBadgeTextStyle}"/>
                            </Border>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <RadioButton Content="時間でキャプチャ"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         IsChecked="{Binding IsIntervalCaptureMode, Mode=TwoWay}"
                                         GroupName="CaptureModeGroup"
                                         Margin="0,0,8,0"/>
                            <RadioButton Content="操作でキャプチャ"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         IsChecked="{Binding IsOnOperationCaptureMode, Mode=TwoWay}"
                                         GroupName="CaptureModeGroup"/>
                        </StackPanel>

                        <!-- 秒モード設定 -->
                        <Border Margin="0,14,0,0"
                                Background="White"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIntervalCaptureMode}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="キャプチャ頻度"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           Margin="0,0,4,0"/>
                                <Border Style="{StaticResource HelpBadgeStyle}" Margin="0,0,8,0">
                                    <Border.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="キャプチャ頻度" Style="{StaticResource ToolTipTitleStyle}"/>
                                                <TextBlock TextWrapping="Wrap" Text="1秒あたり何枚スクリーンショットを撮るかです。"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <TextBlock Style="{StaticResource HelpBadgeTextStyle}"/>
                                </Border>
                                <TextBox Text="{Binding CapturesPerSecond, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldTextBoxStyle}"
                                         Width="52" Margin="0,0,6,0"/>
                                <TextBlock Text="枚/秒（1～10）"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Margin="0,0,22,0"/>

                                <TextBlock Text="保持時間"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           Margin="0,0,4,0"/>
                                <Border Style="{StaticResource HelpBadgeStyle}" Margin="0,0,8,0">
                                    <Border.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="保持時間" Style="{StaticResource ToolTipTitleStyle}"/>
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="バッファ容量の目安です（おおよそ 頻度×秒 枚）。操作に紐づくコマは優先保持します。"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <TextBlock Style="{StaticResource HelpBadgeTextStyle}"/>
                                </Border>
                                <TextBox Text="{Binding RetentionSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldTextBoxStyle}"
                                         Width="52" Margin="0,0,6,0"/>
                                <TextBlock Text="秒（1～120）"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- 操作モード設定 -->
                        <Border Margin="0,14,0,0"
                                Background="White"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnOperationCaptureMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="スクショを取る操作"
                                               Foreground="{StaticResource Brush.TextPrimary}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <Border Style="{StaticResource HelpBadgeStyle}">
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="スクショを取る操作" Style="{StaticResource ToolTipTitleStyle}"/>
                                                    <TextBlock TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"
                                                               Text="枠をクリックしてから、キー1つまたはマウスボタン1つを押すと設定されます。その操作のときだけスクリーンショットを撮ります。"/>
                                                    <TextBlock TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               Text="既定は左クリックです。「クリア」で未設定に戻せます。"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock Style="{StaticResource HelpBadgeTextStyle}"/>
                                    </Border>
                                </StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right"
                                            Content="クリア"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0"
                                            MinHeight="34"
                                            Command="{Binding ClearScreenshotTriggerCommand}"/>
                                    <Border MinHeight="34"
                                            Padding="12,8"
                                            CornerRadius="6"
                                            BorderThickness="1.5"
                                            Cursor="Hand"
                                            Focusable="True"
                                            PreviewMouseDown="OnScreenshotTriggerBoxPreviewMouseDown"
                                            PreviewMouseWheel="OnScreenshotTriggerBoxPreviewMouseWheel"
                                            PreviewKeyDown="OnScreenshotTriggerBoxPreviewKeyDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScreenshotTriggerListening}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Brush.WarningSoft}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ScreenshotTriggerDisplayText}"
                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                    </Border>
                                </DockPanel>

                                <Separator Margin="0,0,0,10" Background="{StaticResource Brush.Border}"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="保持枚数"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextPrimary}"
                                               Margin="0,0,4,0"/>
                                    <Border Style="{StaticResource HelpBadgeStyle}" Margin="0,0,8,0">
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="保持枚数" Style="{StaticResource ToolTipTitleStyle}"/>
                                                    <TextBlock TextWrapping="Wrap"
                                                               Text="操作キャプチャで残しておく画像の最大枚数です。超えた分は古いものから画像を削除します（操作の記録自体は「画像なしの操作」として残ります）。"/>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               Text="範囲: 1～200。記録停止後は自動削除しません。"/>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               Text="開始時・終了時も必ず1枚撮りますが、この2枚も保持枚数のカウントに含まれます。上限を超えれば他のキャプチャと同様に古いものから削除され、常に直近の枚数分だけが残ります。"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock Style="{StaticResource HelpBadgeTextStyle}"/>
                                    </Border>
                                    <TextBox Text="{Binding KeepCaptureCount, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             Width="52" Margin="0,0,6,0"/>
                                    <TextBlock Text="枚（1～200）"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 記録対象（詳細） -->
                <Expander Header="詳細な記録設定（記録対象）"
                          IsExpanded="False"
                          FontWeight="SemiBold"
                          FontSize="13">
                    <StackPanel Margin="4,12,0,4">
                        <CheckBox Content="マウス操作を記録する"
                                  IsChecked="{Binding RecordMouseOperations}"
                                  Margin="0,0,12,10"/>
                        <CheckBox Content="キーボード操作を記録する"
                                  IsChecked="{Binding RecordKeyboard}"
                                  Margin="0,0,12,6"/>
                        <Border Background="{StaticResource Brush.WarningSoft}"
                                BorderBrush="{StaticResource Brush.WarningBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowKeyboardPrivacyNote}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding KeyboardPrivacyNote}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.Warning}"
                                       FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
