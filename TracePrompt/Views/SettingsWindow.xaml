<Window x:Class="TracePrompt.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TracePrompt.Localization"
        Title="{loc:Loc Settings_Title}"
        Height="640"
        Width="560"
        MinHeight="420"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Bg}"
        FontFamily="Yu Gothic UI, Segoe UI">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top"
                   Text="{loc:Loc Settings_Title}"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource Brush.TextPrimary}"
                   Margin="0,0,0,14"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- 操作ボタン（開始／停止は本体のステータスバーへ集約）。
                     削除は取り返しがつかない操作なので、隣の「フォルダを開く」から離し、
                     区切り線を挟んで誤クリックしにくいようにしています。 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="{loc:Loc Common_OpenScreenshotFolder}"
                            Style="{StaticResource LinkButtonStyle}"
                            Padding="14,0"
                            Command="{Binding OpenTempFolderCommand}"/>
                    <Border Width="1" Background="{StaticResource Brush.Border}" Margin="18,4,18,4"/>
                    <Button Content="{loc:Loc Common_DeleteRecordedDataNow}"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="16,0"
                            Command="{Binding ClearHistoryCommand}"/>
                </StackPanel>

                <!-- 言語 / Language -->
                <Border Style="{StaticResource InnerBoxStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_Language_SectionLabel}" Style="{StaticResource LabelStyle}"
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{loc:Loc Settings_Language_Japanese}"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         IsChecked="{Binding IsJapaneseLanguage, Mode=TwoWay}"
                                         GroupName="LanguageGroup"
                                         Margin="0,0,8,0"/>
                            <RadioButton Content="{loc:Loc Settings_Language_English}"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         IsChecked="{Binding IsEnglishLanguage, Mode=TwoWay}"
                                         GroupName="LanguageGroup"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- キャプチャモード -->
                <Border Style="{StaticResource InnerBoxStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4" LastChildFill="False">
                            <TextBlock Text="{loc:Loc Settings_CaptureMode_Label}" Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Style="{StaticResource HelpBadgeStyle}">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Settings_CaptureMode_Label}" Style="{StaticResource ToolTipTitleStyle}"/>
                                            <TextBlock TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"
                                                       Text="{loc:Loc Settings_CaptureMode_Tooltip_Interval}"/>
                                            <TextBlock TextWrapping="Wrap" LineHeight="18"
                                                       Text="{loc:Loc Settings_CaptureMode_Tooltip_Operation}"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Style="{StaticResource HelpBadgeTextStyle}"/>
                            </Border>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <RadioButton Content="{loc:Loc Settings_IntervalCaptureMode_Content}"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         IsChecked="{Binding IsIntervalCaptureMode, Mode=TwoWay}"
                                         GroupName="CaptureModeGroup"
                                         Margin="0,0,8,0"/>
                            <RadioButton Content="{loc:Loc Settings_OperationCaptureMode_Content}"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         IsChecked="{Binding IsOnOperationCaptureMode, Mode=TwoWay}"
                                         GroupName="CaptureModeGroup"/>
                        </StackPanel>

                        <!-- 秒モード設定 -->
                        <Border Margin="0,14,0,0"
                                Background="White"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIntervalCaptureMode}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc Settings_CaptureFrequency_Label}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           Margin="0,0,4,0"/>
                                <Border Style="{StaticResource HelpBadgeStyle}" Margin="0,0,8,0">
                                    <Border.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Settings_CaptureFrequency_Label}" Style="{StaticResource ToolTipTitleStyle}"/>
                                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc Settings_CaptureFrequency_Tooltip}"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <TextBlock Style="{StaticResource HelpBadgeTextStyle}"/>
                                </Border>
                                <TextBox Text="{Binding CapturesPerSecond, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldTextBoxStyle}"
                                         Width="52" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Loc Settings_FramesPerSecond_Unit}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Margin="0,0,22,0"/>

                                <TextBlock Text="{loc:Loc Settings_RetentionTime_Label}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           Margin="0,0,4,0"/>
                                <Border Style="{StaticResource HelpBadgeStyle}" Margin="0,0,8,0">
                                    <Border.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Settings_RetentionTime_Label}" Style="{StaticResource ToolTipTitleStyle}"/>
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="{loc:Loc Settings_RetentionTime_Tooltip}"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <TextBlock Style="{StaticResource HelpBadgeTextStyle}"/>
                                </Border>
                                <TextBox Text="{Binding RetentionSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldTextBoxStyle}"
                                         Width="52" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Loc Settings_RetentionSeconds_Unit}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- 操作モード設定 -->
                        <Border Margin="0,14,0,0"
                                Background="White"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnOperationCaptureMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{loc:Loc Settings_ScreenshotTrigger_Label}"
                                               Foreground="{StaticResource Brush.TextPrimary}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <Border Style="{StaticResource HelpBadgeStyle}">
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc Settings_ScreenshotTrigger_Label}" Style="{StaticResource ToolTipTitleStyle}"/>
                                                    <TextBlock TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"
                                                               Text="{loc:Loc Settings_ScreenshotTrigger_Tooltip1}"/>
                                                    <TextBlock TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               Text="{loc:Loc Settings_ScreenshotTrigger_Tooltip2}"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock Style="{StaticResource HelpBadgeTextStyle}"/>
                                    </Border>
                                </StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right"
                                            Content="{loc:Loc Common_Clear}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0"
                                            MinHeight="34"
                                            Command="{Binding ClearScreenshotTriggerCommand}"/>
                                    <Border MinHeight="34"
                                            Padding="12,8"
                                            CornerRadius="6"
                                            BorderThickness="1.5"
                                            Cursor="Hand"
                                            Focusable="True"
                                            PreviewMouseDown="OnScreenshotTriggerBoxPreviewMouseDown"
                                            PreviewMouseWheel="OnScreenshotTriggerBoxPreviewMouseWheel"
                                            PreviewKeyDown="OnScreenshotTriggerBoxPreviewKeyDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScreenshotTriggerListening}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Brush.WarningSoft}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ScreenshotTriggerDisplayText}"
                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                    </Border>
                                </DockPanel>

                                <Separator Margin="0,0,0,10" Background="{StaticResource Brush.Border}"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Settings_KeepCaptureCount_Label}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextPrimary}"
                                               Margin="0,0,4,0"/>
                                    <Border Style="{StaticResource HelpBadgeStyle}" Margin="0,0,8,0">
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc Settings_KeepCaptureCount_Label}" Style="{StaticResource ToolTipTitleStyle}"/>
                                                    <TextBlock TextWrapping="Wrap"
                                                               Text="{loc:Loc Settings_KeepCaptureCount_Tooltip1}"/>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               Text="{loc:Loc Settings_KeepCaptureCount_Tooltip2}"/>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               Text="{loc:Loc Settings_KeepCaptureCount_Tooltip3}"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock Style="{StaticResource HelpBadgeTextStyle}"/>
                                    </Border>
                                    <TextBox Text="{Binding KeepCaptureCount, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             Width="52" Margin="0,0,6,0"/>
                                    <TextBlock Text="{loc:Loc Settings_KeepCaptureCount_Unit}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 記録対象（詳細） -->
                <Expander Header="{loc:Loc Settings_AdvancedRecording_Header}"
                          IsExpanded="False"
                          FontWeight="SemiBold"
                          FontSize="13">
                    <StackPanel Margin="4,12,0,4">
                        <CheckBox Content="{loc:Loc Settings_RecordMouse_Content}"
                                  IsChecked="{Binding RecordMouseOperations}"
                                  Margin="0,0,12,10"/>
                        <CheckBox Content="{loc:Loc Settings_RecordKeyboard_Content}"
                                  IsChecked="{Binding RecordKeyboard}"
                                  Margin="0,0,12,6"/>
                        <Border Background="{StaticResource Brush.WarningSoft}"
                                BorderBrush="{StaticResource Brush.WarningBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowKeyboardPrivacyNote}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding KeyboardPrivacyNote}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.Warning}"
                                       FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
