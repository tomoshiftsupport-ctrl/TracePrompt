<Window x:Class="TracePrompt.Views.CaptureRegionBorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TracePrompt.Localization"
        Title="{loc:Loc CaptureRegionBorder_Title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- 待機中は青、記録中（一時停止中も含む）はオレンジの細い点線に切り替えます -->
        <Style x:Key="RegionBorderStyle" TargetType="Rectangle">
            <Setter Property="Stroke" Value="#FF3B82F6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                    <Setter Property="Stroke" Value="#FFF97316"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Rectangle Style="{StaticResource RegionBorderStyle}"
               StrokeThickness="1.5"
               StrokeDashArray="4,3"
               SnapsToDevicePixels="True"
               UseLayoutRounding="True"/>
</Window>
