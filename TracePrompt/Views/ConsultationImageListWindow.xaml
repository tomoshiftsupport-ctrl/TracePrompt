<Window x:Class="TracePrompt.Views.ConsultationImageListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TracePrompt.Localization"
        Title="{loc:Loc ConsultationList_Title}"
        Height="760"
        Width="980"
        MinHeight="480"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Bg}"
        FontFamily="Yu Gothic UI, Segoe UI"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{loc:Loc ConsultationList_Instruction}"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- サムネイル一覧 -->
                    <Border Style="{StaticResource TerminalCardStyle}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <TextBlock Text="{Binding ThumbnailSelectionSummaryText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="{loc:Loc ConsultationList_SelectAll}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinHeight="30" Padding="10,0" Margin="0,0,8,0"
                                            Command="{Binding SelectAllThumbnailsCommand}"/>
                                    <Button Content="{loc:Loc ConsultationList_DeselectAll}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinHeight="30" Padding="10,0"
                                            Command="{Binding DeselectAllThumbnailsCommand}"/>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="{loc:Loc ConsultationList_EmptyHint}"
                                       Foreground="{StaticResource Brush.Term.TextDim}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThumbnailFrameCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox ItemsSource="{Binding ThumbnailFrames}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     PreviewMouseWheel="OnThumbnailListPreviewMouseWheel">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,10,10"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="150"
                                                Background="{StaticResource Brush.Term.Panel}"
                                                BorderBrush="{StaticResource Brush.Term.Border}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="6">
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Foreground="White"
                                                          Margin="0,0,0,4"/>
                                                <Border Background="Black" Height="90" CornerRadius="4">
                                                    <Image Source="{Binding ThumbnailImage}"
                                                           Stretch="Uniform"
                                                           Cursor="Hand"
                                                           ToolTip="{loc:Loc ConsultationList_ClickToEnlarge_ToolTip}"
                                                           MouseLeftButtonUp="OnThumbnailImageClick"/>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           Foreground="{StaticResource Brush.Term.TextDim}"
                                                           FontSize="10.5"
                                                           FontFamily="Cascadia Mono, Consolas, Courier New"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- 「選択画像を結合してコピー」用の設定: 1枚あたりのコマ数 / 並び方 / 画質 -->
                    <Border Style="{StaticResource InnerBoxStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc ConsultationList_FramesPerImage_Label}" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="－" MinWidth="34" MinHeight="30" Padding="0"
                                        Style="{StaticResource SecondaryButtonStyle}" FontWeight="Bold" FontSize="14" Margin="0,0,4,0"
                                        ToolTip="{loc:Loc ConsultationList_DecreaseFrames_ToolTip}" Click="OnFramesPerImageDecrementClick"/>
                                <TextBox x:Name="FramesPerImageTextBox" Width="56" MinHeight="30" Padding="4,0"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         Text="{Binding FramesPerImageDisplay, Mode=TwoWay}"
                                         IsEnabled="{Binding IsFramesPerImageAll, Converter={StaticResource InverseBooleanConverter}}"
                                         PreviewMouseWheel="OnFramesPerImageSpinnerPreviewMouseWheel"
                                         PreviewTextInput="OnFramesPerImageTextInput"
                                         PreviewKeyDown="OnFramesPerImageTextBoxPreviewKeyDown"
                                         Margin="0,0,4,0"/>
                                <Button Content="＋" MinWidth="34" MinHeight="30" Padding="0"
                                        Style="{StaticResource SecondaryButtonStyle}" FontWeight="Bold" FontSize="14" Margin="0,0,6,0"
                                        ToolTip="{loc:Loc ConsultationList_IncreaseFrames_ToolTip}" Click="OnFramesPerImageIncrementClick"/>
                                <TextBlock Text="{loc:Loc Unit_Frames}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,14,0"/>
                                <CheckBox Content="{loc:Loc ConsultationList_All_Content}" Style="{StaticResource ToggleChipStyle}"
                                          IsChecked="{Binding IsFramesPerImageAll, Mode=TwoWay}"/>
                            </StackPanel>

                            <TextBlock Text="{loc:Loc ConsultationList_Layout_Label}" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="－" MinWidth="34" MinHeight="30" Padding="0"
                                        Style="{StaticResource SecondaryButtonStyle}" FontWeight="Bold" FontSize="14" Margin="0,0,4,0"
                                        ToolTip="{loc:Loc ConsultationList_DecreaseColumns_ToolTip}" Click="OnLayoutColumnsDecrementClick"/>
                                <TextBox x:Name="LayoutColumnsTextBox" Width="56" MinHeight="30" Padding="4,0"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         Text="{Binding LayoutColumns, Mode=TwoWay}"
                                         IsEnabled="{Binding IsLayoutAuto, Converter={StaticResource InverseBooleanConverter}}"
                                         PreviewMouseWheel="OnLayoutColumnsSpinnerPreviewMouseWheel"
                                         PreviewTextInput="OnLayoutColumnsTextInput"
                                         PreviewKeyDown="OnLayoutColumnsTextBoxPreviewKeyDown"
                                         Margin="0,0,4,0"/>
                                <Button Content="＋" MinWidth="34" MinHeight="30" Padding="0"
                                        Style="{StaticResource SecondaryButtonStyle}" FontWeight="Bold" FontSize="14" Margin="0,0,6,0"
                                        ToolTip="{loc:Loc ConsultationList_IncreaseColumns_ToolTip}" Click="OnLayoutColumnsIncrementClick"/>
                                <TextBlock Text="{loc:Loc Unit_Columns}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,14,0"/>
                                <CheckBox Content="{loc:Loc ConsultationList_Auto_Content}" Style="{StaticResource ToggleChipStyle}"
                                          IsChecked="{Binding IsLayoutAuto, Mode=TwoWay}"/>
                            </StackPanel>

                            <TextBlock Text="{loc:Loc ConsultationList_Quality_Label}" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{loc:Loc ConsultationList_Quality_TextPriority}" Style="{StaticResource SegmentedRadioButtonStyle}"
                                             IsChecked="{Binding IsQualityTextPriority, Mode=TwoWay}"
                                             GroupName="QualityGroup" Margin="0,0,6,0"/>
                                <RadioButton Content="{loc:Loc ConsultationList_Quality_Standard}" Style="{StaticResource SegmentedRadioButtonStyle}"
                                             IsChecked="{Binding IsQualityStandard, Mode=TwoWay}"
                                             GroupName="QualityGroup" Margin="0,0,6,0"/>
                                <RadioButton Content="{loc:Loc ConsultationList_Quality_SizePriority}" Style="{StaticResource SegmentedRadioButtonStyle}"
                                             IsChecked="{Binding IsQualitySizePriority, Mode=TwoWay}"
                                             GroupName="QualityGroup"/>
                            </StackPanel>

                            <Separator Margin="0,14,0,10" Background="{StaticResource Brush.Border}"/>

                            <CheckBox Content="{loc:Loc ConsultationList_UseCustomSettings_Content}"
                                      IsChecked="{Binding UseCustomAutoCombineSettings, Mode=TwoWay}"
                                      ToolTip="{loc:Loc ConsultationList_UseCustomSettings_ToolTip}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- コピー結果の確認: 外部アプリを開かなくても、今クリップボードにある実際の内容を確認できます -->
            <Border Grid.Row="2" Style="{StaticResource InnerBoxStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc ConsultationList_ClipboardReview_Label}" Style="{StaticResource LabelStyle}"/>
                        <Button Content="{loc:Loc ConsultationList_Recheck}"
                                DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="26" Padding="10,0"
                                Command="{Binding RefreshClipboardPreviewCommand}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ClipboardPreviewSummary}"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <Border BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            Background="White"
                            CornerRadius="6"
                            MinHeight="120"
                            MaxHeight="240"
                            Padding="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAnyClipboardPreviewVisual}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Image Source="{Binding ClipboardPreviewImage}"
                                   Stretch="Uniform"
                                   Margin="4"
                                   Cursor="Hand"
                                   ToolTip="{loc:Loc ConsultationList_ClickToAnnotate_ToolTip}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   MouseLeftButtonUp="OnClipboardImageClick">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasClipboardPreviewImage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasClipboardPreviewFileThumbnails}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <ItemsControl ItemsSource="{Binding ClipboardPreviewFileThumbnails}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Black"
                                                    Width="120" Height="90"
                                                    CornerRadius="4"
                                                    Margin="0,0,8,8">
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform"
                                                       Cursor="Hand"
                                                       ToolTip="{loc:Loc ConsultationList_ClickToAnnotate_ToolTip}"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       MouseLeftButtonUp="OnClipboardFileThumbnailClick"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- アクション -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="{loc:Loc ConsultationList_CombineAndCopy_Content}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="{loc:Loc ConsultationList_CombineAndCopy_ToolTip}"
                        MinWidth="190"
                        Margin="0,0,10,0"
                        Command="{Binding GenerateAndCopySelectedCombinedCommand}"/>
                <Button Content="{loc:Loc ConsultationList_CopyWithoutCombining_Content}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="{loc:Loc ConsultationList_CopyWithoutCombining_ToolTip}"
                        MinWidth="140"
                        Margin="0,0,10,0"
                        Command="{Binding CopySelectedAsFilesCommand}"/>
                <Border Width="1" Background="{StaticResource Brush.Border}" Margin="8,4,18,4"/>
                <Button Content="{loc:Loc Common_OpenScreenshotFolder}"
                        Style="{StaticResource LinkButtonStyle}"
                        ToolTip="{Binding OpenTempFolderTooltipText}"
                        Padding="14,0"
                        Command="{Binding OpenTempFolderCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 拡大ビューアー オーバーレイ: サムネイルクリックで表示。前後の画像へ移動しつつ選択の切替もできます。 -->
        <Border x:Name="ViewerOverlay"
                Background="#EE0B0F17"
                Visibility="Collapsed">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                    <CheckBox x:Name="ViewerCheckBox"
                              Content="{loc:Loc ConsultationList_SelectThisImage_Content}"
                              Foreground="White"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Checked="OnViewerCheckBoxChanged"
                              Unchecked="OnViewerCheckBoxChanged"/>
                    <TextBlock x:Name="ViewerLabel"
                               Foreground="{StaticResource Brush.Term.TextDim}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                    <Button DockPanel.Dock="Right"
                            Content="{loc:Loc ConsultationList_CloseViewer_Content}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinHeight="30" Padding="10,0"
                            Click="OnViewerCloseClick"/>
                </DockPanel>

                <!-- 赤ペン・拡大縮小ツールバー: 別窓を開かず、この画面だけで記入・保存まで完結します。 -->
                <Border Grid.Row="1"
                        Background="#1A1D28"
                        CornerRadius="6"
                        Padding="8,6"
                        Margin="0,0,0,10">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Border Background="{StaticResource Brush.DangerSoft}"
                                    BorderBrush="{StaticResource Brush.DangerBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.Danger}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{loc:Loc Common_RedPenBadge}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource Brush.Danger}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="ViewerUndoButton" Content="{loc:Loc ConsultationList_Undo_Content}" Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="30" Padding="8,0" FontSize="12" Margin="0,0,6,0"
                                    ToolTip="{loc:Loc ConsultationList_Undo_ToolTip}" Click="OnViewerUndoClick"/>
                            <Button x:Name="ViewerRedoButton" Content="{loc:Loc ConsultationList_Redo_Content}" Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="30" Padding="8,0" FontSize="12" Margin="0,0,6,0"
                                    ToolTip="{loc:Loc ConsultationList_Redo_ToolTip}" Click="OnViewerRedoClick"/>
                            <Button Content="{loc:Loc ConsultationList_ClearLines_Content}" Style="{StaticResource DangerButtonStyle}"
                                    MinHeight="30" Padding="8,0" FontSize="12"
                                    ToolTip="{loc:Loc ConsultationList_ClearLines_ToolTip}" Click="OnViewerClearClick"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="{loc:Loc Common_Save}" Style="{StaticResource PrimaryButtonStyle}"
                                    MinHeight="30" Padding="10,0" FontSize="12" Margin="0,0,10,0"
                                    ToolTip="{loc:Loc ConsultationList_Save_ToolTip}" Click="OnViewerSaveClick"/>
                            <Button Content="－" Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="30" MinHeight="30" Padding="0" FontWeight="Bold" FontSize="14" Margin="0,0,4,0"
                                    ToolTip="{loc:Loc ConsultationList_ZoomOut_ToolTip}" Click="OnViewerZoomOutClick"/>
                            <Button x:Name="ViewerZoomPercentButton" Content="100%" Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="56" MinHeight="30" Padding="4,0" FontSize="12" Margin="0,0,4,0"
                                    ToolTip="{loc:Loc ConsultationList_ZoomReset_ToolTip}" Click="OnViewerZoomResetClick"/>
                            <Button Content="＋" Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="30" MinHeight="30" Padding="0" FontWeight="Bold" FontSize="14"
                                    ToolTip="{loc:Loc ConsultationList_ZoomIn_ToolTip}" Click="OnViewerZoomInClick"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ViewerPrevButton"
                            Grid.Column="0"
                            Content="&#8249;"
                            FontSize="28"
                            Width="52" Height="80"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="{loc:Loc ConsultationList_PrevImage_ToolTip}"
                            Click="OnViewerPrevClick"/>

                    <Border Grid.Column="1" Background="#2A2D38" CornerRadius="6" Margin="12,0" ClipToBounds="True">
                        <ScrollViewer x:Name="ViewerCanvasScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      PanningMode="Both"
                                      Background="Transparent"
                                      PreviewMouseWheel="OnViewerCanvasPreviewMouseWheel"
                                      SizeChanged="OnViewerCanvasSizeChanged">
                            <Grid x:Name="ViewerComposeRoot"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Background="Transparent">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="ViewerScaleTransform" ScaleX="1" ScaleY="1"/>
                                </Grid.LayoutTransform>
                                <Image x:Name="ViewerBackgroundImage"
                                       Stretch="Fill"
                                       SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <InkCanvas x:Name="ViewerInkSurface"
                                           Background="Transparent"
                                           EditingMode="Ink"
                                           Cursor="Pen"
                                           StrokeCollected="OnViewerStrokeCollected"
                                           StrokeErasing="OnViewerStrokeErasing">
                                    <InkCanvas.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Loc ContextMenu_CopyImage}" Click="OnViewerCopyImageClick"/>
                                        </ContextMenu>
                                    </InkCanvas.ContextMenu>
                                </InkCanvas>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <Button x:Name="ViewerNextButton"
                            Grid.Column="2"
                            Content="&#8250;"
                            FontSize="28"
                            Width="52" Height="80"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="{loc:Loc ConsultationList_NextImage_ToolTip}"
                            Click="OnViewerNextClick"/>
                </Grid>

                <TextBlock Grid.Row="3"
                           Text="{loc:Loc ConsultationList_ViewerHint}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Term.TextDim}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
