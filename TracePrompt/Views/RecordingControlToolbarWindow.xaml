<Window x:Class="TracePrompt.Views.RecordingControlToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIヘルプキャプチャ 録画コントロール"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="Yu Gothic UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="CompactPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="CompactSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="CompactGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
    </Window.Resources>

    <Border Background="#EE1A1D28" CornerRadius="8" Padding="6">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="開始"
                        Style="{StaticResource CompactPrimaryButtonStyle}"
                        Foreground="White"
                        Command="{Binding StartRecordingCommand}">
                    <Button.Visibility>
                        <Binding Path="IsIdle"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding>
                    </Button.Visibility>
                </Button>
                <Button Content="一時停止"
                        Style="{StaticResource CompactSecondaryButtonStyle}"
                        Command="{Binding PauseRecordingCommand}">
                    <Button.Visibility>
                        <Binding Path="IsRecording"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding>
                    </Button.Visibility>
                </Button>
                <Button Content="再開"
                        Style="{StaticResource CompactPrimaryButtonStyle}"
                        Foreground="White"
                        Command="{Binding ResumeRecordingCommand}">
                    <Button.Visibility>
                        <Binding Path="IsPaused"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding>
                    </Button.Visibility>
                </Button>
                <Button Content="停止"
                        Style="{StaticResource CompactSecondaryButtonStyle}"
                        Margin="6,0,0,0"
                        Command="{Binding StopRecordingCommand}">
                    <Button.Visibility>
                        <Binding Path="IsSessionActive"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding>
                    </Button.Visibility>
                </Button>

            </StackPanel>

            <StackPanel Margin="2,4,2,0">
                <StackPanel.Visibility>
                    <Binding Path="HasRecordingOverlayStatus"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding>
                </StackPanel.Visibility>

                <StackPanel Opacity="0.68">
                    <StackPanel.Visibility>
                        <Binding Path="IsSessionActive"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding>
                    </StackPanel.Visibility>
                    <TextBlock Text="{Binding RecordingOverlayElapsedText}"
                               FontSize="10.5"
                               Foreground="#F2F6FF" />
                    <TextBlock Text="{Binding RecordingOverlayActivityText}"
                               Margin="0,1,0,0"
                               FontSize="10"
                               Foreground="#D8E0EF" />
                </StackPanel>

                <Border Margin="0,6,0,0"
                        Padding="8,6"
                        CornerRadius="6"
                        Background="#163D2D"
                        BorderBrush="#49DE80"
                        BorderThickness="1.5">
                    <Border.Visibility>
                        <Binding Path="HasRecordingOverlayNotice"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding>
                    </Border.Visibility>
                    <StackPanel>
                        <TextBlock Text="{Binding RecordingOverlayNoticeText}"
                                   TextWrapping="Wrap"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="#F3FFF8" />
                        <Button Content="フォルダを開く"
                                Style="{StaticResource CompactGhostButtonStyle}"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenTempFolderCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>




