<Window x:Class="TracePrompt.Views.ImageAnnotatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TracePrompt.Localization"
        Title="{loc:Loc Annotator_Title}"
        Height="720"
        Width="1100"
        MinHeight="420"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Bg}"
        FontFamily="Yu Gothic UI, Segoe UI"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <DockPanel Margin="12">

        <Border DockPanel.Dock="Top"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="{StaticResource Brush.DangerSoft}"
                            BorderBrush="{StaticResource Brush.DangerBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource Brush.Danger}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{loc:Loc Common_RedPenBadge}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource Brush.Danger}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ImageNavigationPanel"
                            Background="{StaticResource Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ImageIndexText"
                                   MinWidth="54"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <Button x:Name="UndoButton"
                            Content="{loc:Loc Annotator_UndoButton_Content}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="148"
                            Margin="0,0,8,0"
                            Click="OnUndoClick"
                            ToolTip="{loc:Loc ConsultationList_Undo_ToolTip}"/>
                    <Button x:Name="RedoButton"
                            Content="{loc:Loc Annotator_RedoButton_Content}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="148"
                            Margin="0,0,8,0"
                            Click="OnRedoClick"
                            ToolTip="{loc:Loc ConsultationList_Redo_ToolTip}"/>
                    <Button Content="{loc:Loc Annotator_ClearAll_Content}"
                            Style="{StaticResource DangerButtonStyle}"
                            Width="100"
                            Click="OnClearClick"
                            ToolTip="{loc:Loc ConsultationList_ClearLines_ToolTip}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource Brush.PrimarySoft}"
                            BorderBrush="{StaticResource Brush.Primary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Annotator_ZoomLabel}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{StaticResource Brush.PrimaryDark}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,8,0"/>
                            <Button Content="－"
                                    MinWidth="44"
                                    MinHeight="34"
                                    Padding="10,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    FontWeight="Bold"
                                    FontSize="18"
                                    Margin="0,0,6,0"
                                    Click="OnZoomOutClick"
                                    ToolTip="{loc:Loc Annotator_ZoomOut_ToolTip}"/>
                            <Button x:Name="ZoomPercentButton"
                                    Content="100%"
                                    MinWidth="72"
                                    MinHeight="34"
                                    Padding="10,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    FontWeight="SemiBold"
                                    Margin="0,0,6,0"
                                    Click="OnZoomResetClick"
                                    ToolTip="{loc:Loc Annotator_ZoomReset_ToolTip}"/>
                            <Button Content="＋"
                                    MinWidth="44"
                                    MinHeight="34"
                                    Padding="10,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    FontWeight="Bold"
                                    FontSize="18"
                                    Click="OnZoomInClick"
                                    ToolTip="{loc:Loc Annotator_ZoomIn_ToolTip}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusText"
                               Text="{loc:Loc Annotator_InitialStatus}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="12.5"
                               Margin="0,0,12,0"/>
                    <Button Content="{loc:Loc Common_Copy}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="88"
                            Margin="0,0,8,0"
                            Click="OnCopyImageClick"
                            ToolTip="{loc:Loc Annotator_CopyButton_ToolTip}"/>
                    <Button Content="{loc:Loc Common_Save}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="88"
                            Margin="0,0,8,0"
                            Click="OnSaveClick"
                            ToolTip="{loc:Loc Annotator_SaveButton_ToolTip}"/>
                    <Button Content="{loc:Loc Common_Close}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="88"
                            Click="OnCloseClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Text="{loc:Loc Annotator_HintText}"
                   Style="{StaticResource HintTextStyle}"
                   Margin="2,0,2,10"/>

        <Grid>
            <Border Background="#2A2D38"
                    BorderBrush="{StaticResource Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <ScrollViewer x:Name="CanvasScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="Both"
                              Background="Transparent"
                              PreviewMouseWheel="OnCanvasPreviewMouseWheel"
                              SizeChanged="OnCanvasViewportSizeChanged">
                    <Grid x:Name="ComposeRoot"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Background="Transparent">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ViewScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>
                        <Image x:Name="BackgroundImage"
                               Stretch="Fill"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <InkCanvas x:Name="InkSurface"
                                   Background="Transparent"
                                   EditingMode="Ink"
                                   Cursor="Pen"
                                   StrokeCollected="OnStrokeCollected"
                                   StrokeErasing="OnStrokeErasing">
                            <InkCanvas.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc ContextMenu_CopyImage}" Click="OnCopyImageClick"/>
                                </ContextMenu>
                            </InkCanvas.ContextMenu>
                        </InkCanvas>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Button x:Name="PrevImageButton"
                    Content="&lt;"
                    Width="52"
                    Height="80"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0"
                    Panel.ZIndex="2"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Background="#F9FAFB"
                    Foreground="#111827"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Click="OnPrevImageClick"
                    ToolTip="{loc:Loc Annotator_PrevImage_ToolTip}"/>

            <Button x:Name="NextImageButton"
                    Content="&gt;"
                    Width="52"
                    Height="80"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Panel.ZIndex="2"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Background="#F9FAFB"
                    Foreground="#111827"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Click="OnNextImageClick"
                    ToolTip="{loc:Loc Annotator_NextImage_ToolTip}"/>
        </Grid>
    </DockPanel>
</Window>
