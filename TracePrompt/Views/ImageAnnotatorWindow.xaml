<Window x:Class="TracePrompt.Views.ImageAnnotatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="画像を開く・赤ペン記入"
        Height="720"
        Width="1100"
        MinHeight="420"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Bg}"
        FontFamily="Yu Gothic UI, Segoe UI"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <DockPanel Margin="12">

        <Border DockPanel.Dock="Top"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="{StaticResource Brush.DangerSoft}"
                            BorderBrush="{StaticResource Brush.DangerBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource Brush.Danger}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="赤ペン"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource Brush.Danger}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ImageNavigationPanel"
                            Background="{StaticResource Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ImageIndexText"
                                   MinWidth="54"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <Button x:Name="UndoButton"
                            Content="元に戻す (Ctrl+Z)"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="148"
                            Margin="0,0,8,0"
                            Click="OnUndoClick"
                            ToolTip="直前の線を取り消します（Ctrl+Z）"/>
                    <Button x:Name="RedoButton"
                            Content="やり直す (Ctrl+Y)"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="148"
                            Margin="0,0,8,0"
                            Click="OnRedoClick"
                            ToolTip="取り消した線を戻します（Ctrl+Y）"/>
                    <Button Content="すべて消す"
                            Style="{StaticResource DangerButtonStyle}"
                            Width="100"
                            Click="OnClearClick"
                            ToolTip="記入した線をすべて消します"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource Brush.PrimarySoft}"
                            BorderBrush="{StaticResource Brush.Primary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="表示"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{StaticResource Brush.PrimaryDark}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,8,0"/>
                            <Button Content="－"
                                    MinWidth="44"
                                    MinHeight="34"
                                    Padding="10,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    FontWeight="Bold"
                                    FontSize="18"
                                    Margin="0,0,6,0"
                                    Click="OnZoomOutClick"
                                    ToolTip="縮小 (Ctrl+- / Ctrl+ホイール)"/>
                            <Button x:Name="ZoomPercentButton"
                                    Content="100%"
                                    MinWidth="72"
                                    MinHeight="34"
                                    Padding="10,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    FontWeight="SemiBold"
                                    Margin="0,0,6,0"
                                    Click="OnZoomResetClick"
                                    ToolTip="画面に合わせて全体表示 (Ctrl+0)"/>
                            <Button Content="＋"
                                    MinWidth="44"
                                    MinHeight="34"
                                    Padding="10,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    FontWeight="Bold"
                                    FontSize="18"
                                    Click="OnZoomInClick"
                                    ToolTip="拡大 (Ctrl++ / Ctrl+ホイール)"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusText"
                               Text="ドラッグで赤線を描けます"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="12.5"
                               Margin="0,0,12,0"/>
                    <Button Content="コピー"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="88"
                            Margin="0,0,8,0"
                            Click="OnCopyImageClick"
                            ToolTip="表示中の画像（赤ペン記入込み）をクリップボードへコピーします（Ctrl+C）"/>
                    <Button Content="保存"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="88"
                            Margin="0,0,8,0"
                            Click="OnSaveClick"
                            ToolTip="記入内容を画像に書き込んで保存します"/>
                    <Button Content="閉じる"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="88"
                            Click="OnCloseClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Text="ドラッグで赤線を記入。左右キーまたは矢印ボタンで画像を切り替え。Ctrl+ホイール / Ctrl+± で拡大縮小、Ctrl+0 で全体表示に戻します。Ctrl+C または右クリックで画像をコピーできます。保存すると元の画像ファイルを上書きします。"
                   Style="{StaticResource HintTextStyle}"
                   Margin="2,0,2,10"/>

        <Grid>
            <Border Background="#2A2D38"
                    BorderBrush="{StaticResource Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <ScrollViewer x:Name="CanvasScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="Both"
                              Background="Transparent"
                              PreviewMouseWheel="OnCanvasPreviewMouseWheel"
                              SizeChanged="OnCanvasViewportSizeChanged">
                    <Grid x:Name="ComposeRoot"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Background="Transparent">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ViewScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>
                        <Image x:Name="BackgroundImage"
                               Stretch="Fill"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <InkCanvas x:Name="InkSurface"
                                   Background="Transparent"
                                   EditingMode="Ink"
                                   Cursor="Pen"
                                   StrokeCollected="OnStrokeCollected"
                                   StrokeErasing="OnStrokeErasing">
                            <InkCanvas.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="画像をコピー (Ctrl+C)" Click="OnCopyImageClick"/>
                                </ContextMenu>
                            </InkCanvas.ContextMenu>
                        </InkCanvas>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Button x:Name="PrevImageButton"
                    Content="&lt;"
                    Width="52"
                    Height="80"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0"
                    Panel.ZIndex="2"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Background="#F9FAFB"
                    Foreground="#111827"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Click="OnPrevImageClick"
                    ToolTip="前の画像へ移動"/>

            <Button x:Name="NextImageButton"
                    Content="&gt;"
                    Width="52"
                    Height="80"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Panel.ZIndex="2"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Background="#F9FAFB"
                    Foreground="#111827"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Click="OnNextImageClick"
                    ToolTip="次の画像へ移動"/>
        </Grid>
    </DockPanel>
</Window>
