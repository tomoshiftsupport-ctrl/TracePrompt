<Window x:Class="TracePrompt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:TracePrompt.Localization"
        mc:Ignorable="d"
        Title="{Binding AppName}"
        Icon="Assets/app.ico"
        Width="400"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        Background="{StaticResource Brush.Term.Bg}"
        FontFamily="Yu Gothic UI, Segoe UI"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="OnWindowPreviewMouseDownForPopups">
    <Window.Resources>

        <!-- ツールバー主操作（開始／再開）の下地: 常設シャドウ＋記録中は赤グローが脈打つ丸ボタン。
             Snipping Tool の1段アイコンツールバーを参考に、テキストラベルなしのアイコンのみで構成します。 -->
        <Style x:Key="ToolbarPrimaryToggleStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="17" Background="{TemplateBinding Background}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0B0D14" BlurRadius="10" ShadowDepth="1" Opacity="0.35"/>
                                </Border.Effect>
                            </Border>
                            <!-- 記録中だけ脈打つ赤いグロー（既定は不可視） -->
                            <Border CornerRadius="17" Background="{TemplateBinding Background}">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="Glow" Color="#DC2626" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Bg"
                                    CornerRadius="17"
                                    Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <!-- Tag に IsRecording をバインドして、実際に記録中のときだけ脈動させる -->
                            <Trigger Property="Tag" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseBeginStoryboard">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                             From="0.25" To="0.9" Duration="0:0:0.9"
                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius"
                                                             From="8" To="22" Duration="0:0:0.9"
                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseBeginStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ツールバーの控えめな丸ボタン（一時停止・AI相談データ・設定など、色を持たない操作用） -->
        <Style x:Key="ToolbarNeutralButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Term.Border}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Term.Selected}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ツールバーのトグル式アイコン（範囲ドロップダウン／キャプチャモード切替）。選択中は背景をハイライト -->
        <Style x:Key="ToolbarIconToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,9"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Term.Border}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Term.Selected}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 範囲モード／モニター選択のドロップダウン（Snipping Tool の「四角形／ウィンドウ／全画面表示／フリーフォーム」
             メニューを参考にした、アイコン＋文字の行）。
             以前は WPF 標準の ContextMenu / MenuItem に開閉を任せていましたが、ContextMenu は既定で
             「外側クリックで自動的に閉じる」ため、開いている状態でトグルボタン自身をもう一度押すと
             ①その自動クローズが先に発生し ②直後にボタンの Click が飛んで開き直す、という競合が起き、
             「ボタンを押している間だけ消え、離すと再び開く」不具合になっていました。
             そこで Popup（StaysOpen="True" で自動クローズを無効化）に置き換え、開閉は
             ボタンの Click ハンドラーで IsOpen を明示的に反転する一本の経路だけに統一します。
             「外をクリックしたら閉じる」ぶんは Window レベルの PreviewMouseDown で自前に判定します
             （OnWindowPreviewMouseDownForPopups 参照）。 -->
        <!-- 「今どちらが選ばれているか」を分かりやすくするため、独自アイコンではなく
             チェックマーク（✓）1つだけに統一します（IsChecked="True" の行にだけ表示）。 -->
        <Style x:Key="RegionModeOptionButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="CheckGlyph"
                                           DockPanel.Dock="Left"
                                           Text="&#10003;"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="{StaticResource Brush.Primary}"
                                           Width="22"
                                           VerticalAlignment="Center"
                                           Visibility="Hidden"/>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DropdownPopupBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.22"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Brush.Term.Border}"/>
            <Setter Property="Margin" Value="4,7"/>
        </Style>

        <!-- 開始／再開アイコン: 白い輪郭の丸（録画ボタンの定番モチーフ） -->
        <Style x:Key="RecordIconStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
        </Style>

        <!-- 停止アイコン: 白い塗りの四角（メディアの「■停止」の定番モチーフ） -->
        <Style x:Key="StopIconStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Fill" Value="White"/>
            <Setter Property="RadiusX" Value="2"/>
            <Setter Property="RadiusY" Value="2"/>
        </Style>

        <!-- 一時停止アイコン（ツールバー用・ダーク背景向けに明るいグレー）: 縦棒2本 -->
        <Style x:Key="ToolbarPauseBarStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="3.2"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="{StaticResource Brush.Term.Text}"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
        </Style>

        <!-- 既定の Expander はライトテーマ向けの文字色のため、ダーク背景のこの窓向けに上書きします -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource Brush.Term.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- ツールバー: Snipping Tool を参考にした、アイコンのみの1段バー。
             ①範囲選択・キャプチャモード・記録操作・②設定・③AI相談データへの入口をここに集約し、
             本体はキャプチャの邪魔にならないよう常に薄く保ちます。 -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Brush.Term.Panel}"
                BorderBrush="{StaticResource Brush.Term.Border}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10,8" VerticalAlignment="Center">

                <!-- 範囲モード（全画面／クリップ）: Snipping Tool の「四角形／ウィンドウ／全画面表示／…」
                     ドロップダウンを参考にしたメニュー形式。開閉は Click ハンドラーで RegionModePopup.IsOpen を
                     明示的に反転するだけの単純な作りです（詳しい経緯は RegionModeOptionButtonStyle の
                     コメント、および OnRegionModeToggleButtonClick 参照）。 -->
                <Button x:Name="RegionModeToggleButton"
                        Style="{StaticResource ToolbarNeutralButtonStyle}"
                        ToolTip="{loc:Loc MainWindow_RegionModeButton_ToolTip}"
                        IsEnabled="{Binding IsIdle}"
                        Click="OnRegionModeToggleButtonClick">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="15" Height="12">
                            <!-- 全画面表示アイコン: 実線の四角 -->
                            <Rectangle Stroke="{StaticResource Brush.Term.Text}" StrokeThickness="1.4" RadiusX="1.5" RadiusY="1.5">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFullScreenRegionMode}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <!-- クリップアイコン: 破線の四角 -->
                            <Rectangle Stroke="{StaticResource Brush.Term.Text}" StrokeThickness="1.4" StrokeDashArray="2,1.3" RadiusX="1.5" RadiusY="1.5">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFreeClipRegionMode}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </Grid>
                        <TextBlock Text="&#9662;" Foreground="{StaticResource Brush.Term.TextDim}" FontSize="9"
                                   Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Popup x:Name="RegionModePopup"
                       PlacementTarget="{Binding ElementName=RegionModeToggleButton}"
                       Placement="Bottom"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <Border Style="{StaticResource DropdownPopupBorderStyle}">
                        <StackPanel>
                            <ToggleButton x:Name="FullScreenModeMenuItem"
                                          Content="{loc:Loc MainWindow_RegionMode_FullScreen}"
                                          Style="{StaticResource RegionModeOptionButtonStyle}"
                                          IsChecked="{Binding IsFullScreenRegionMode, Mode=OneWay}"
                                          Click="OnSelectFullScreenModeClick"/>
                            <ToggleButton x:Name="ClipModeMenuItem"
                                          Content="{loc:Loc MainWindow_RegionMode_Clip}"
                                          Style="{StaticResource RegionModeOptionButtonStyle}"
                                          IsChecked="{Binding IsFreeClipRegionMode, Mode=OneWay}"
                                          Click="OnSelectClipModeClick"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- モニター選択（全画面モードのときだけ表示）。一覧はクリック時に動的生成しますが、
                     開閉自体は範囲モードと同じ Popup + 明示トグル方式です。 -->
                <Button x:Name="MonitorToggleButton"
                        Style="{StaticResource ToolbarNeutralButtonStyle}"
                        ToolTip="{loc:Loc MainWindow_MonitorButton_ToolTip}"
                        IsEnabled="{Binding IsIdle}"
                        Click="OnMonitorToggleButtonClick">
                    <Button.Visibility>
                        <Binding Path="IsFullScreenRegionMode">
                            <Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter>
                        </Binding>
                    </Button.Visibility>
                    <StackPanel Orientation="Horizontal">
                        <!-- 「画面を選ぶ」アイコン: 全画面モードの四角アイコンと見分けやすいよう、
                             画面の中に対角線を1本入れています（モニター選択の定番モチーフ）。 -->
                        <Grid Width="14" Height="10">
                            <Rectangle Stroke="{StaticResource Brush.Term.Text}" StrokeThickness="1.4" RadiusX="1.5" RadiusY="1.5"/>
                            <Line X1="2.5" Y1="7.5" X2="11.5" Y2="2.5" Stroke="{StaticResource Brush.Term.Text}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <TextBlock Text="&#9662;" Foreground="{StaticResource Brush.Term.TextDim}" FontSize="9"
                                   Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Popup x:Name="MonitorPopup"
                       PlacementTarget="{Binding ElementName=MonitorToggleButton}"
                       Placement="Bottom"
                       StaysOpen="True"
                       AllowsTransparency="True">
                    <Border Style="{StaticResource DropdownPopupBorderStyle}">
                        <StackPanel x:Name="MonitorPopupItemsPanel"/>
                    </Border>
                </Popup>

                <Border Style="{StaticResource ToolbarDividerStyle}"/>

                <!-- キャプチャする: 押すたびに毎回、必ず枠を表示させる一方通行のボタンです（選択・非選択の
                     2状態は持ちません）。全画面モードでは選んだモニターに枠を表示、クリップモードでは
                     ドラッグでの範囲選択操作を開始し、選び終わったらそのまま枠を表示します。
                     ツールバーの中で唯一の主要操作なので、色を付けて目立たせています。 -->
                <Button x:Name="CaptureButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        FontSize="12.5"
                        IsEnabled="{Binding IsIdle}"
                        Click="OnCaptureButtonClick"
                        Content="{loc:Loc MainWindow_CaptureButton_Content}"/>

                <Border Style="{StaticResource ToolbarDividerStyle}"/>

                <!-- キャプチャモード: 時間で／操作で（クロック＝連続撮影、タップ＝操作トリガー）。
                     CaptureMode の内部セッターは「今と同じ値なら何もせず return」するため、
                     既に選ばれている方をもう一度押すと PropertyChanged が飛ばず、
                     クリックで一旦崩れた見た目（ToggleButton 自身が内部で反転させる分）を
                     バインディングが直しきれず「見た目だけ未選択に戻る」不具合になります
                     （範囲モードのときと同じ落とし穴）。Click 側で毎回、両方の IsChecked を
                     明示的に設定し直すことで、確実に正しい見た目にします。 -->
                <ToggleButton x:Name="IntervalModeToggleButton"
                              Style="{StaticResource ToolbarIconToggleButtonStyle}"
                              ToolTip="{loc:Loc MainWindow_IntervalMode_ToolTip}"
                              IsEnabled="{Binding IsIdle}"
                              IsChecked="{Binding IsIntervalCaptureMode, Mode=OneWay}"
                              Click="OnSelectIntervalCaptureModeClick">
                    <Grid Width="16" Height="16">
                        <Ellipse Stroke="{StaticResource Brush.Term.Text}" StrokeThickness="1.4"/>
                        <Line X1="8" Y1="8" X2="8" Y2="3" Stroke="{StaticResource Brush.Term.Text}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="8" Y1="8" X2="11.5" Y2="8" Stroke="{StaticResource Brush.Term.Text}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </ToggleButton>
                <ToggleButton x:Name="OperationModeToggleButton"
                              Style="{StaticResource ToolbarIconToggleButtonStyle}"
                              ToolTip="{loc:Loc MainWindow_OperationMode_ToolTip}"
                              IsEnabled="{Binding IsIdle}"
                              IsChecked="{Binding IsOnOperationCaptureMode, Mode=OneWay}"
                              Click="OnSelectOperationCaptureModeClick">
                    <!-- マウスカーソル風の矢印アイコン（操作トリガーの定番モチーフ） -->
                    <Grid Width="16" Height="16">
                        <Polygon Points="2,1 2,11.5 5,8.8 7,13 8.6,12.2 6.6,8 10.5,8"
                                 Fill="{StaticResource Brush.Term.Text}"/>
                    </Grid>
                </ToggleButton>

                <Border Style="{StaticResource ToolbarDividerStyle}"/>

                <!-- 記録の開始／一時停止／再開／停止の操作はこのウィンドウには置きません。
                     キャプチャ範囲確定後は小型ウィンドウ（CompactRecordingWindow）側に一本化しています
                     （このウィンドウは記録中も「戻る」で表示され得ますが、操作は小型ウィンドウ専用です）。 -->

                <!-- AI相談用データ: 記録停止のたびに自動生成・自動コピー済み。ここは確認・選び直し専用の入口。
                     未確認のデータがあるとき（HasConsultationPreview）は右上に緑のバッジを出します。 -->
                <Button Style="{StaticResource ToolbarNeutralButtonStyle}"
                        Click="OnOpenImageListClick">
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="260">
                                <TextBlock Text="{loc:Loc MainWindow_ConsultationButton_Title}" Style="{StaticResource ToolTipTitleStyle}"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="{loc:Loc MainWindow_ConsultationButton_Description}"/>
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <Grid Width="16" Height="16">
                        <Rectangle Stroke="{StaticResource Brush.Term.Text}" StrokeThickness="1.3" RadiusX="2" RadiusY="2"/>
                        <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Term.Text}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3.5,3.5,0,0"/>
                        <Polyline Points="1,12 6,7 9,10 12,6 15,10" Stroke="{StaticResource Brush.Term.Text}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round"/>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Term.Accent}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasConsultationPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                </Button>

                <!-- スクショ保存フォルダを開く（フォルダアイコン）。SettingsWindow / ConsultationImageListWindow と
                     同じ OpenTempFolderCommand をここからも直接呼べるようにします。
                     アイコンはタブ付きフォルダのアウトライン1本（塗りなし・角丸）。24単位の座標系で描き、
                     Stretch="Uniform" で他のツールバーアイコンと同じ 16x16 相当に収めています。 -->
                <Button Style="{StaticResource ToolbarNeutralButtonStyle}"
                        ToolTip="{loc:Loc MainWindow_OpenFolder_ToolTip}"
                        Command="{Binding OpenTempFolderCommand}">
                    <Path Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
                          Stretch="Uniform"
                          Width="16"
                          Height="16"
                          Stroke="{StaticResource Brush.Term.Text}"
                          StrokeThickness="2"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Button>

                <!-- 設定: 頻度・保持・記録対象などの詳細設定を別窓で開きます（歯車アイコン） -->
                <Button Style="{StaticResource ToolbarNeutralButtonStyle}"
                        ToolTip="{loc:Loc MainWindow_Settings_ToolTip}"
                        Click="OnOpenSettingsClick">
                    <TextBlock Text="&#xE713;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{StaticResource Brush.Term.Text}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- 本体: 状態ヒント＋任意で開く操作履歴（Snipping Tool の「レコーディングを開始するには…」ヒント欄を参考に） -->
        <ScrollViewer x:Name="MainPageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18">

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource Brush.Term.TextDim}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="10,26,10,22"/>

                <!-- 操作履歴（起動時は非表示。記録開始後、または履歴があるとき表示）。
                     普段は折りたたんでおき、必要なときだけ開いて本体窓の高さを抑えます。 -->
                <Expander Header="{loc:Loc MainWindow_History_Header}"
                          IsExpanded="False"
                          FontWeight="SemiBold"
                          FontSize="13"
                          Margin="0,0,0,2">
                    <Expander.Visibility>
                        <Binding Path="IsHistoryPanelVisible">
                            <Binding.Converter>
                                <BooleanToVisibilityConverter/>
                            </Binding.Converter>
                        </Binding>
                    </Expander.Visibility>
                    <Border Style="{StaticResource TerminalCardStyle}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc MainWindow_History_Hint}"
                                       Style="{StaticResource HintTextStyle}"
                                       Foreground="{StaticResource Brush.Term.TextDim}"
                                       Margin="0,0,0,10"/>

                            <!-- 履歴一覧: ターミナル風ログ -->
                            <Border BorderBrush="{StaticResource Brush.Term.Border}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Background="{StaticResource Brush.Term.Panel}"
                                    Margin="0,0,0,10">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource TerminalPaneHeaderStyle}">
                                        <TextBlock Text="history.log"
                                                   Style="{StaticResource TerminalPaneLabelStyle}"/>
                                    </Border>
                                    <ListBox x:Name="OperationHistoryListBox"
                                             Height="170"
                                             Style="{StaticResource TerminalListBoxStyle}"
                                             ItemsSource="{Binding OperationHistory}"
                                             SelectedItem="{Binding SelectedHistoryItem}"
                                             PreviewMouseWheel="OnOperationHistoryPreviewMouseWheel">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 種別マーク: ▣=画面あり / ●=操作のみ / >=状態 -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding LogMarker}"
                                                               FontWeight="Bold"
                                                               Margin="0,0,8,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Term.TextDim}"/>
                                                                <Style.Triggers>
                                                                    <!-- 緑●は「画面なしの操作」だけ。操作キャプチャ行は水色▣ -->
                                                                    <DataTrigger Binding="{Binding IsPlainActionLog}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Term.Accent}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCaptureLog}" Value="True">
                                                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayText}"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Term.Text}"/>
                                                                <Style.Triggers>
                                                                    <!-- 画面キャプチャ行は水色で目立たせる -->
                                                                    <DataTrigger Binding="{Binding IsCaptureLog}" Value="True">
                                                                        <Setter Property="Foreground" Value="#7DD3FC"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- プレビュー: クリックで別画面（拡大縮小・赤ペン） -->
                            <Border BorderBrush="{StaticResource Brush.Term.Border}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Background="{StaticResource Brush.Term.Panel}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource TerminalPaneHeaderStyle}">
                                        <TextBlock Text="preview"
                                                   Style="{StaticResource TerminalPaneLabelStyle}"/>
                                    </Border>
                                    <Grid x:Name="HistoryPreviewHost" Height="170" Margin="10">
                                        <TextBlock Text="{Binding PreviewPlaceholderText}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Brush.Term.TextDim}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPreviewImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding PreviewImage}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Cursor="Hand"
                                               MouseLeftButtonUp="OnHistoryPreviewImageClick">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPreviewImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
