<Application x:Class="TracePrompt.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TracePrompt"
             xmlns:converters="clr-namespace:TracePrompt.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

            <!-- ============ 繧ｫ繝ｩ繝ｼ繝代Ξ繝・ヨ ============ -->
            <SolidColorBrush x:Key="Brush.Bg" Color="#F3F5F9"/>
            <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F7F9FC"/>
            <SolidColorBrush x:Key="Brush.Border" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C7D2E0"/>

            <SolidColorBrush x:Key="Brush.Primary" Color="#2F6FED"/>
            <SolidColorBrush x:Key="Brush.PrimaryDark" Color="#1F56C4"/>
            <SolidColorBrush x:Key="Brush.PrimarySoft" Color="#EAF1FE"/>

            <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1E293B"/>
            <SolidColorBrush x:Key="Brush.TextSecondary" Color="#64748B"/>
            <SolidColorBrush x:Key="Brush.TextMuted" Color="#94A3B8"/>

            <SolidColorBrush x:Key="Brush.Success" Color="#15803D"/>
            <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#F0FDF4"/>
            <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#86EFAC"/>

            <SolidColorBrush x:Key="Brush.Warning" Color="#B45309"/>
            <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FFF7ED"/>
            <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FDBA74"/>

            <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626"/>
            <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FEF2F2"/>
            <SolidColorBrush x:Key="Brush.DangerBorder" Color="#FCA5A5"/>

            <!-- 繧ｿ繝ｼ繝溘リ繝ｫ鬚ｨ繝ｭ繧ｰ陦ｨ遉ｺ逕ｨ繝代Ξ繝・ヨ -->
            <SolidColorBrush x:Key="Brush.Term.Bg" Color="#14161F"/>
            <SolidColorBrush x:Key="Brush.Term.Panel" Color="#1A1D28"/>
            <SolidColorBrush x:Key="Brush.Term.Header" Color="#0F1117"/>
            <SolidColorBrush x:Key="Brush.Term.Border" Color="#2B2F3D"/>
            <SolidColorBrush x:Key="Brush.Term.Text" Color="#C9D1D9"/>
            <SolidColorBrush x:Key="Brush.Term.TextDim" Color="#6E7684"/>
            <SolidColorBrush x:Key="Brush.Term.Accent" Color="#5EEAD4"/>
            <SolidColorBrush x:Key="Brush.Term.Selected" Color="#26304A"/>
            <!-- ============ カード / 見出し ============ -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="InnerBoxStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,12"/>
            </Style>

            <!-- ============ 繧ｿ繝ｼ繝溘リ繝ｫ鬚ｨ繧ｫ繝ｼ繝会ｼ域桃菴懷ｱ･豁ｴ・・============ -->
            <Style x:Key="TerminalCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Background" Value="{StaticResource Brush.Term.Bg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Term.Border}"/>
            </Style>

            <Style x:Key="TerminalPaneHeaderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Brush.Term.Header}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Term.Border}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="CornerRadius" Value="7,7,0,0"/>
                <Setter Property="Padding" Value="10,7"/>
            </Style>

            <Style x:Key="TerminalPaneLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Term.TextDim}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ログ行: 選択・ホバーで背景が変わります。 -->
            <Style x:Key="TerminalListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Margin="4,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1F2330"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Term.Selected}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#102A22"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TerminalListBoxStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4,6"/>
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource TerminalListBoxItemStyle}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

            <Style x:Key="StepBadgeStyle" TargetType="Border">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="CornerRadius" Value="13"/>
                <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="StepBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SectionHintStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="34,3,0,0"/>
            </Style>

            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- ============ 繝倥Ν繝励鯉ｼ溘阪ヰ繝・ず ============ -->
            <Style x:Key="HelpBadgeStyle" TargetType="Border">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Background" Value="{StaticResource Brush.TextMuted}"/>
                <Setter Property="Cursor" Value="Help"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            </Style>

            <Style x:Key="HelpBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="Text" Value="?"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ToolTipTitleStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="MaxWidth" Value="330"/>
                <Setter Property="Padding" Value="10,8"/>
            </Style>

            <!-- ============ 繝懊ち繝ｳ ============ -->
            <Style x:Key="BaseButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg"
                                    CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.DangerBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="LinkButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{StaticResource Brush.PrimarySoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryDark}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>

            <!-- ============ 蜈･蜉帶ｬ・============ -->
            <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
                <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
            </Style>

            <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- ============ 繧ｻ繧ｰ繝｡繝ｳ繝亥・譖ｿ・医く繝｣繝励メ繝｣繝｢繝ｼ繝会ｼ・============ -->
            <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16,9"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg"
                                    CornerRadius="7"
                                    BorderThickness="1.5"
                                    BorderBrush="{StaticResource Brush.BorderStrong}"
                                    Background="White">
                                <ContentPresenter HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Primary}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 「すべて」自動トグル用: 見た目は SegmentedRadioButtonStyle と同じですが、
                 単独でオン/オフを切り替えられるよう CheckBox をベースにしています。 -->
            <Style x:Key="ToggleChipStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16,9"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Bg"
                                    CornerRadius="7"
                                    BorderThickness="1.5"
                                    BorderBrush="{StaticResource Brush.BorderStrong}"
                                    Background="White">
                                <ContentPresenter HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Primary}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ CheckBox / Expander ============ -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
